{
	"luci-app-mieru": {
		"description": "Grant access to Mieru Client configuration and status",
		"read": {
			"ubus": {
				"uci": [ "get" ],
				"luci.mieru": [ "getStatus", "pingServer", "tcpConnect", "validateConfig", "testSocks5", "readLog", "getBackups", "exportBackup", "getAutostartStatus" ],
				"service": [ "list" ],
				"rc": [ "list" ],
				"luci": [ "getProcessList" ]
			},
			"uci": [ "mieru" ]
		},
		"write": {
			"ubus": {
				"uci": [ "set", "commit" ],
				"luci.mieru": [ "clearLog", "importBackup", "confirmRestore", "deleteBackup", "restoreBackup", "resetConfig", "importJson", "confirmImportJson", "createManualBackup", "setAutostart" ],
				"rc": [ "init" ]
			},
			"uci": [ "mieru" ]
		}
	}
}
